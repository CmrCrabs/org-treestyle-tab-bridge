{
  "manifest_version": 3,
  "name": "org-treestyle-tab-bridge",
  "version": "1.0",

  "description": "treestyle tab org-mode file interface for backups.",

  "icons": {
    "48": "icons/org-treestyle-48.png"
    "96": "icons/org-treestyle-96.png"
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "borderify@mozilla.org",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },

  "content_scripts": [
    {
      "matches": ["*://*.mozilla.org/*"],
      "js": ["borderify.js"]
    }
  ]
}
