{
  "manifest_version": 3,
  "name": "org-treestyle-tab-bridge",
  "version": "1.0",

  "description": "treestyle tab org-mode file interface.",

  "icons": {
      "48": "icons/org-treestyle-48.png",
      "96": "icons/org-treestyle-96.png"
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "org-treestyle-bridge@zfazam",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },

  "background": {
    "scripts": ["org-treestyle.js"],
    "type": "module"
  },

  "host_permissions": ["http://localhost/8080/*"]
}
